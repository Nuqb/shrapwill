{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shrapwill",
  "version": "0.9.0",
  "identifier": "studio.cutline.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shrapwill",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#16181e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost 'self';",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "A focused, local video editor",
    "category": "Video",
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": ["notices/*", "icons/shrapwill-taskbar-5d076e58.ico"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "compression": "zlib"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
